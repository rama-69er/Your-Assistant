# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional GitHub Actions APK Builder integration (server-side only, never expose to client):
# Format: owner/repo (e.g. "yourname/shimi-assistant")
GITHUB_REPO=""
# Personal Access Token or fine-grained token with actions:write & contents:read
GITHUB_TOKEN=""
# Branch to dispatch .github/workflows/build-apk.yml against
GITHUB_REF="main"
